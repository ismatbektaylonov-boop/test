<%- include("../includes/header", { pageTitle: "Boshqaruv paneli | MyLibrary" , extraCss: "products" }) %>

  <main class="products-container">
    <%- include("../includes/nav", { member, active: "products" }) %>

      <section class="products-dashboard" aria-labelledby="admin-title">
        <header class="catalog-header">
          <div>
            <p class="eyebrow">BOSHQARUV PANELI</p>
            <h1 id="admin-title">Barcha kitoblar.</h1>
            <p class="catalog-subtitle">Yashirilgan nusxalar ham shu yerda ko'rinadi — faqat admin uchun.</p>
          </div>
          <div class="catalog-actions">
            <span class="product-count">
              <%= products.length %> nom
            </span>
            <a href="/admin/products/new" class="primary-action">+ Kitob qo'shish</a>
            <a href="/admin/orders" class="secondary-action">So'rovlarni ko'rish</a>
            <a href="/products" class="secondary-action">Ommaviy sahifaga o'tish</a>
          </div>
          </div>
        </header>

        <form class="search-bar" method="GET" action="/admin">
          <input type="text" name="search" placeholder="Kitob nomi yoki muallif bo'yicha qidirish..."
            value="<%= search %>" />
          <button type="submit" class="secondary-action">Qidirish</button>
        </form>

        <% if (products.length===0) { %>
          <section class="empty-catalog" aria-label="Bo'sh katalog">
            <p class="eyebrow">KATALOG BO'SH</p>
            <h2>Hech qanday kitob topilmadi.</h2>
            <p>Qidiruv shartlarini o'zgartiring yoki yangi kitob qo'shing.</p>
          </section>
          <% } else { %>
            <section class="product-grid" aria-label="Kitoblar katalogi (admin)">
              <% products.forEach(function(p) { %>
                <article class="product-card" data-id="<%= p._id %>">
                  <div class="product-visual product-visual--with-image">
                    <% if (p.productImage) { %>
                      <img class="product-cover-image" src="<%= p.productImage %>" alt="<%= p.productName %>"
                        loading="lazy" />
                      <% } %>
                        <span>
                          <%= p.productGenre %>
                        </span>
                  </div>
                  <div class="product-card-body">
                    <div class="product-card-heading">
                      <div>
                        <p class="product-collection">
                          <%= p.productGenre %>
                        </p>
                        <h2>
                          <%= p.productName %>
                        </h2>
                      </div>
                    </div>
                    <p class="product-collection" style="margin-top:-2px;">Muallif: <%= p.productAuthor || "—" %>
                    </p>
                    <div class="product-meta">
                      <span>Holati <strong>
                          <%= p.productStatus %>
                        </strong></span>
                      <% if (p.isRecommended) { %>
                        <span>⭐ Tavsiya</span>
                        <% } %>
                    </div>

                    <div class="product-card-footer">
                      <a href="/admin/products/<%= p._id %>/edit" class="primary-action">Tahrirlash</a>
                      <form method="POST" action="/admin/products/<%= p._id %>/delete"
                        onsubmit="return confirm('Ushbu kitob butunlay o\'chirilsinmi?')">
                        <button type="submit" class="secondary-action delete-btn">O'chirish</button>
                      </form>
                    </div>
                  </div>
                </article>
                <% }); %>
            </section>
            <% } %>
      </section>
  </main>

  <script src="/js/main.js"></script>
  </body>

  </html>