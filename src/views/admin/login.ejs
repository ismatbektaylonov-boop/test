<%- include("../includes/header", { pageTitle: "Admin kirish | MyLibrary" , extraCss: "login" }) %>

  <main class="login-container">
    <div class="login-frame">
      <div class="login-top">
        <a href="/" class="brand">
          <span class="brand-mark">📖</span>
          MyLibrary
        </a>
        <p class="eyebrow">BOSHQARUV PANELI</p>
        <h1>Admin sifatida kiring</h1>
        <p class="intro">Kitoblarni qo'shish, tahrirlash va so'rovlarni boshqarish uchun tizimga kiring.</p>
      </div>

      <% if (error) { %>
        <div id="formError" class="form-error">
          <%= error %>
        </div>
        <% } %>

          <form method="POST" action="/admin/login" class="login-input-frame">
            <div class="login-input-container">
              <label for="memberEmail">Email</label>
              <input type="email" id="memberEmail" name="memberEmail" required autofocus />
            </div>
            <div class="login-input-container">
              <label for="memberPassword">Parol</label>
              <input type="password" id="memberPassword" name="memberPassword" required />
            </div>
            <button type="submit" class="login-btn">Kirish</button>
          </form>
    </div>
  </main>

  <script src="/js/main.js"></script>
  </body>

  </html>