<%- include("includes/header", { pageTitle: product.productName + " | MyLibrary" , extraCss: "product-detail" }) %>

	<div class="app-shell">
		<%- include("includes/sidebar", { member, active: "products" }) %>

			<main class="app-main">
				<%- include("includes/topbar", { member }) %>

					<section class="detail-wrap" aria-labelledby="detail-title">
						<a href="/products" class="back-link">&larr; Barcha kitoblarga qaytish</a>

						<div class="detail-grid">
							<div class="detail-cover">
								<% if (product.productImage) { %>
									<img src="<%= product.productImage %>" alt="<%= product.productName %>" />
									<% } else { %>
										<div class="detail-cover-placeholder">📖</div>
										<% } %>
											<span class="detail-status detail-status--<%= product.productStatus.toLowerCase() %>">
												<%= product.productStatus==="AVAILABLE" ? "Mavjud" : product.productStatus==="BORROWED" ? "Band"
													: product.productStatus %>
											</span>
							</div>

							<div class="detail-info">
								<p class="eyebrow">
									<%= product.productGenre %>
								</p>
								<h1 id="detail-title">
									<%= product.productName %>
								</h1>
								<p class="detail-author">
									<%= product.productAuthor ? "Muallif: " + product.productAuthor : "Muallif noma'lum" %>
								</p>

								<div class="detail-desc">
									<% if (product.productDesc) { %>
										<p>
											<%= product.productDesc %>
										</p>
										<% } else { %>
											<p class="detail-desc-empty">Bu kitob haqida hali tavsif qo'shilmagan.</p>
											<% } %>
								</div>

								<div class="detail-actions">
									<% if (canRead) { %>
										<button type="button" class="primary-action" id="openReaderBtn"
											data-src="/products/<%= product._id %>/read-file#toolbar=0&navpanes=0&scrollbar=1">📖 Kitobni
											o'qish</button>
										<% } %>

											<% if (member && member.memberType==="USER" && !canRead) { %>
												<button class="primary-action rent-btn" data-id="<%= product._id %>" <%=product.productStatus
													!=="AVAILABLE" ? "disabled" : "" %>
													>
													<%= product.productStatus !=="AVAILABLE" ? "Hozircha mavjud emas" : "Ijaraga olish" %>
												</button>
												<% } else if (!member) { %>
													<a href="/login" class="primary-action">Ijaraga olish uchun kiring</a>
													<% } %>

														<% if (member && member.memberType==="ADMIN" ) { %>
															<a href="/admin/products/<%= product._id %>/edit" class="secondary-action">Tahrirlash</a>
															<% } %>
								</div>
							</div>
						</div>
					</section>

					<% if (canRead) { %>
						<div class="reader-overlay" id="readerOverlay">
							<div class="reader-window">
								<div class="reader-window-head">
									<span>📖 <%= product.productName %></span>
									<button type="button" class="reader-close" id="closeReaderBtn" aria-label="Yopish">&times;</button>
								</div>
								<iframe id="readerFrame" class="reader-frame" src="" title="Kitobni o'qish"></iframe>
							</div>
						</div>
						<% } %>
			</main>
	</div>

	<script src="/js/main.js"></script>
	<script src="/js/products.js"></script>
	<% if (canRead) { %>
		<script>
			(function () {
				var openBtn = document.getElementById('openReaderBtn')
				var overlay = document.getElementById('readerOverlay')
				var frame = document.getElementById('readerFrame')
				var closeBtn = document.getElementById('closeReaderBtn')

				openBtn.addEventListener('click', function () {
					frame.src = openBtn.getAttribute('data-src')
					overlay.classList.add('open')
					document.body.style.overflow = 'hidden'
				})

				function closeReader() {
					overlay.classList.remove('open')
					frame.src = ''
					document.body.style.overflow = ''
				}

				closeBtn.addEventListener('click', closeReader)
				overlay.addEventListener('click', function (e) {
					if (e.target === overlay) closeReader()
				})
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') closeReader()
				})
			})()
		</script>
		<% } %>
			</body>

			</html>